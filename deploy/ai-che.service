[Unit]
Description=AI Studio Che — FastAPI app (gunicorn + uvicorn workers)
Documentation=https://aiche.ru
After=network.target

[Service]
Type=notify
WorkingDirectory=/root/AI-CHE
EnvironmentFile=/root/AI-CHE/.env
# Gunicorn с UvicornWorker — поддерживает rolling reload через SIGHUP.
# Конфиг в gunicorn.conf.py: workers=4, timeout=180, graceful_timeout=60,
# max_requests=10000, access-log → journal.
ExecStart=/root/AI-CHE/venv/bin/gunicorn main:app -c /root/AI-CHE/gunicorn.conf.py
# Reload: SIGHUP → gunicorn перезагружает workers (старые TERM, новые fork
# от master). У нас стартап нового worker'а тяжёлый (~9 сек: импорт 26
# модулей + scheduler init), поэтому короткое окно ~5-9 сек когда новые
# workers ещё бутятся → 502. Это **не zero-downtime**, но лучше restart:
#   - Restart: жёсткий kill всех + полный старт (10-20 сек)
#   - Reload: graceful_timeout=60 + fork workers (~7-10 сек)
# Истинный zero-downtime требует blue/green (см. docs/DEPLOY.md).
ExecReload=/bin/kill -HUP $MAINPID
PIDFile=/run/ai-che.pid

Restart=on-failure
RestartSec=5
StartLimitInterval=300
StartLimitBurst=5

# Logs → journalctl. Gunicorn пишет в stdout/stderr (см. gunicorn.conf.py).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-che

# Security hardening (минимально-безопасный набор —
# ProtectSystem=strict / ProtectHome=true ломали uvicorn workers
# в инциденте 2026-04-27, поэтому используем щадящий вариант)
NoNewPrivileges=yes
PrivateTmp=yes

# Лимиты
LimitNOFILE=65536
# Type=notify требует чтобы gunicorn master сам сигналил sd_notify(READY=1) —
# UvicornWorker делает это автоматически. Если возникнут проблемы со стартом
# (status=activating>limit) — поменять Type=notify → Type=simple. Гибрид
# работает, но без notify systemd не знает когда сервис «реально готов».
TimeoutStartSec=60
# Graceful stop: дать gunicorn (graceful_timeout=60) + буфер.
TimeoutStopSec=90

# При reload не убивать процессы master/workers — gunicorn сам разруливает
# через HUP. KillMode=mixed = SIGTERM master, SIGKILL children-orphans
# если master не убил.
KillMode=mixed

[Install]
WantedBy=multi-user.target

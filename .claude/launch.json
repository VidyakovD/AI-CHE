{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ai-service",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--reload", "--host", "127.0.0.1", "--port", "8001"],
      "port": 8001,
      "env": {
        "DEV_MODE": "true",
        "APP_ENV": "dev",
        "ALLOWED_ORIGINS": "http://localhost:8001",
        "ADMIN_EMAILS": "preview-test@example.com",
        "JWT_SECRET": "dev-jwt-secret-32-chars-long-yes-yes",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "balance-test",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "9876"],
      "port": 9876
    }
  ]
}

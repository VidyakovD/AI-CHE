# ── AI Keys (comma-separated for multiple) ────────────────────────
OPENAI_API_KEYS=sk-proj-...
ANTHROPIC_API_KEYS=sk-ant-api03-...
# Если используется прокси (например awstore.cloud) — задай:
# ANTHROPIC_BASE_URL=https://api.awstore.cloud
PERPLEXITY_API_KEYS=pplx-...
GROK_API_KEYS=xai-...
KLING_API_KEYS=...
GOOGLE_API_KEYS=AIzaSyAIHS_VwqktPJn3pO5CrDB...

# ── Veo (Google Cloud) ─────────────────────────────────────────
VEO_PROJECT_ID=your-gcp-project-id

# ── YooKassa ──────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=test_...

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
# Старые JWT_SECRET'ы через запятую — для расшифровки старых IMAP-паролей
# после ротации ключа. После вызова /admin/reencrypt-secrets можно удалить.
LEGACY_JWT_SECRETS=

# ── Internal API (multi-surface billing) ──────────────────────────
# Общий секрет для HMAC между aiche.ru и клиентами Internal API:
# VK Mini App backend (aichevk.ru), TG-бот @aiche_bot, MAX-бот @aiche_max.
# Каждый клиент шлёт X-Internal-Timestamp + X-Internal-Signature =
# HMAC-SHA256(ts + "." + body, INTERNAL_API_SECRET).
# Пусто = endpoints /internal/v1/* возвращают 503 (фейл-closed).
INTERNAL_API_SECRET=

# ── @aiche_bot — общий TG-бот платформы (multi-surface) ───────────
# Бот для новых юзеров: /start → auto-create User по tg_user_id → доступ
# к AI с балансом aiche.ru. Параллельно с personal-ботами юзеров (где
# каждый юзер свой бот через @BotFather для общения со СВОИМ Че).
#
# Получить токен: @BotFather → /newbot → копируй сюда.
AICHE_TG_BOT_TOKEN=
# Секрет в URL webhook'а (защита от случайных запросов).
# Сгенерь: openssl rand -hex 24
AICHE_TG_BOT_WEBHOOK_SECRET=
# Username бота БЕЗ @ (для генерации deep-link'ов привязки с сайта).
# Узнаётся в @BotFather → Edit bots → выбираешь бота → Bot Username.
AICHE_TG_BOT_USERNAME=

# ── VK Mini App (multi-surface VKMA, домен aichevk.ru) ────────────
# Surface VKMA = ещё один клиент aiche.ru-баланса, рядом с web/TG/MAX.
# Авторизация через VK launch_params HMAC.
VK_APP_ID=
# Secret key VK-приложения. БЕЗ него auth = 503 в проде (fail-closed).
VK_APP_SECURE_KEY=
# Service token VK (для wall.get, users.get и т.д. от имени приложения)
VK_APP_SERVICE_TOKEN=
# AES-256 ключ для шифрования VK community access_token'ов в vkma_communities.
# ВАЖНО: при ротации этого ключа все сохранённые токены станут нечитаемыми.
# Генерация:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── Kling (если будет использоваться отдельным VKMA Studio роутом) ─
# Может совпадать с KLING_API_KEYS из aiche-БД (в admin.html → ApiKey).
# Здесь — отдельные env для VK Studio эндпоинтов если нужно разводить.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE=https://api-singapore.klingai.com
KLING_DEFAULT_MODEL=kling-v1-6

# Публичный URL backend'а для VK Callback (приходит на этот URL).
# Если меняется — VK перестанет доставлять сообщения в зарегистрированные
# сообщества. Не менять без переключения Callback в VK Admin сообщества.
API_PUBLIC_URL=https://aichevk.ru
# Frontend URL для CORS — Mini App статика отдаётся отсюда.
FRONTEND_URL=https://aichevk.ru

# ── Yandex.Disk Backup ───────────────────────────────────────────
# OAuth token from https://oauth.yandex.ru/
# Scopes: cloud_api:disk.upload
YAD_TOKEN=

# ── Email (SMTP) ──────────────────────────────────────────────────
# Если не задан SMTP_HOST — письма логируются в консоль (dev режим)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Obsidian AI <you@gmail.com>

# ── App ───────────────────────────────────────────────────────────
APP_URL=https://yourdomain.com

# ── CORS (comma-separated origins, required for production) ──────
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Admin ─────────────────────────────────────────────────────────
# ADMIN_EMAILS — список через запятую, кто видит /admin.html
# ADMIN_EMAIL/ADMIN_PASSWORD — учётка для create_admin.py (single)
ADMIN_EMAILS=admin@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# ── Trusted proxies (для X-Forwarded-For в rate-limit) ───────────
# Список IP откуда приходят запросы за прокси. По умолчанию: 127.0.0.1,::1
# Пример для Cloudflare: 173.245.48.0/20,103.21.244.0/22,...
TRUSTED_PROXIES=127.0.0.1,::1

# ── Dev mode (CORS) ──────────────────────────────────────────────
# В проде НЕ ВКЛЮЧАЙТЕ. Локально позволяет запускать без ALLOWED_ORIGINS
DEV_MODE=false

# ── Python sandbox в воркфлоу ботов ──────────────────────────────
# По умолчанию выключен — exec() небезопасен. Включайте только если
# понимаете риски (RCE-вектор от владельцев ботов).
ENABLE_PYTHON_SANDBOX=false

# ── Deploy ────────────────────────────────────────────────────────
DEPLOY_TOKEN=change_me_to_random_string

# ── Sentry (мониторинг ошибок) ───────────────────────────────────
# Регистрация: https://sentry.io/ → Create Project → FastAPI →
# скопировать DSN. Без него exceptions видны только в логах сервера
# (journalctl), а UI-баги типа HTTP 500 в creators ни в каких логах
# не всплывают, пока юзер не пожалуется. Sentry соберёт stack-traces
# + breadcrumbs + автоматически дедуплицирует.
# Рекомендованные опции:
#   SENTRY_TRACES_SAMPLE_RATE=0.1 — 10% запросов для performance-monitoring
#   SENTRY_ENV=prod | dev
# SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/YYY
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENV=prod

# ── Anthropic Proxy (optional) ───────────────────────────────────
# PROXY_TOKEN=change_me_for_proxy_auth

# ── Bonuses (уменьшение дефолтов — анти-фрод) ────────────────────
# Раньше было 5000 и 10000 — легко накрутить через массовые регистрации
WELCOME_BONUS_CH=500        # приветственный при верификации email
REFERRAL_SIGNUP_BONUS=1000  # при регистрации друга по реф-коду
